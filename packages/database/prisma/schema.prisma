generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  passwordHash String
  role         Role
  createdAt    DateTime     @default(now())

  firstName    String?
  middleName   String?
  lastName     String?
  email        String?      @unique
  mobile       String?
  countryCode  String?
  dob          String?
  country      String?
  city         String?
  profilePhoto String?
  address         String?
  fideProfile     String?
  lichessProfile  String?
  chesscomProfile String?
  
  student      Student?
  coach        Coach?
  folders      Folder[]     @relation("UserFolders")
  collections  Collection[] @relation("UserCollections")
  sharesSent   Share[]      @relation("SharedByRelation")
  sharesRecv   Share[]      @relation("SharedWithRelation")
}

model Student {
  id           String       @id @default(uuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  parentFirstName    String?
  parentMiddleName   String?
  parentLastName     String?
  parentEmail        String?
  parentMobile       String?
  secParentFirstName  String?
  secParentMiddleName String?
  secParentLastName   String?
  secParentEmail      String?
  secParentMobile     String?

  attendance   Attendance[]
  enrollments  Enrollment[]
  makeovers    Makeover[]
}

model Coach {
  id           String       @id @default(uuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  specialization String?
  bio            String?

  classes      Class[]
}

model Class {
  id           String       @id @default(uuid())
  className    String
  coachId      String?      // Optional for restore
  program      String?      
  type         String?      
  startDate    String?      
  days         String[]     
  startTime    String?      
  endTime      String?      
  status       String       @default("active")
  createdAt    DateTime     @default(now())
  
  coach        Coach?       @relation(fields: [coachId], references: [id], onDelete: Cascade)
  attendance   Attendance[]
  enrollments  Enrollment[]
  sessionOverrides ClassSessionOverride[]
  originalMakeovers Makeover[] @relation("OriginalClass")
  targetMakeovers   Makeover[] @relation("TargetClass")
  sessions          Session[]
}

model Enrollment {
  id        String @id @default(uuid())
  studentId String? // Optional for restore
  classId   String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
}

model Attendance {
  id        String   @id @default(uuid())
  classId   String
  studentId String? // Optional for restore
  date      DateTime @db.Date
  status    String
  markedBy  String
  timestamp DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId, date])
}

model Program {
  id          String         @id @default(uuid())
  name        String         @unique
  code        String?
  order       Int            @default(0)
  description String?
  topics      ProgramTopic[]
  createdAt   DateTime       @default(now())
}

model ProgramTopic {
  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

enum Role {
  ADMIN
  COACH
  STUDENT
}

model Classroom {
  id         Int             @id @default(autoincrement())
  batch_id   String
  status     ClassroomStatus @default(PENDING)
  stateData  Json?
  started_at DateTime?
  ended_at   DateTime?
  created_at DateTime        @default(now())
}

enum ClassroomStatus {
  PENDING
  ACTIVE
  ENDED
}

model ClassSessionOverride {
  id           String   @id @default(uuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  originalDate DateTime @db.Date
  newDate      DateTime @db.Date
  newStartTime String?
  newEndTime   String?
  status       String   @default("RESCHEDULED") // "RESCHEDULED", "CANCELLED"
  reason       String?
  createdAt    DateTime @default(now())

  @@unique([classId, originalDate])
}

model Makeover {
  id               String   @id @default(uuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  originalClassId  String
  originalClass    Class    @relation("OriginalClass", fields: [originalClassId], references: [id], onDelete: Cascade)
  originalDate     DateTime @db.Date
  
  targetClassId    String?
  targetClass      Class?   @relation("TargetClass", fields: [targetClassId], references: [id], onDelete: Cascade)
  targetDate       DateTime? @db.Date
  
  status           String   @default("PENDING") // PENDING, SCHEDULED, COMPLETED, CANCELLED
  coachId          String?  
  assignedByAdmin  Boolean  @default(false)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Session {
  id          String   @id @default(uuid())
  title       String
  date        DateTime @db.Date
  startTime   String
  endTime     String
  duration    Int
  platform    String
  meetingLink String?
  description String?
  status      String   @default("Upcoming") // Upcoming, Live, Completed, Cancelled
  
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  agenda      Json?
  attachments Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  key   String @id
  data  Json
}

model Folder {
  id             String       @id @default(uuid())
  ownerId        String
  owner          User         @relation("UserFolders", fields: [ownerId], references: [id], onDelete: Cascade)
  parentFolderId String?
  parentFolder   Folder?      @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders   Folder[]     @relation("FolderHierarchy")
  name           String
  visibility     String       // 'public' | 'private'
  collections    Collection[]

  @@index([ownerId])
  @@index([parentFolderId])
}

model Collection {
  id          String       @id @default(uuid())
  ownerId     String
  owner       User         @relation("UserCollections", fields: [ownerId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name        String
  visibility  String       // 'public' | 'private'
  source      String       // 'upload' | 'analysis' | 'classroom'
  createdAt   DateTime     @default(now())
  games       Game[]
  shares      Share[]

  @@index([ownerId])
  @@index([folderId])
}

model Game {
  id           String     @id @default(uuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  orderIndex   Int
  chapterName  String
  pgn          String     @db.Text
  headers      Json       // JSONB
  initialFen   String?
  result       String?

  @@index([collectionId])
}

model Share {
  id               String     @id @default(uuid())
  collectionId     String
  collection       Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sharedBy         String
  sharedByUser     User       @relation("SharedByRelation", fields: [sharedBy], references: [id], onDelete: Cascade)
  sharedWithUser   String
  sharedWithUserRel User      @relation("SharedWithRelation", fields: [sharedWithUser], references: [id], onDelete: Cascade)
  permission       String     // 'read' | 'write'

  @@unique([collectionId, sharedWithUser])
  @@index([collectionId])
  @@index([sharedWithUser])
}

